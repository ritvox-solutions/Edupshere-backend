# Neon: use the DIRECT endpoint (host WITHOUT "-pooler", no pgbouncer/channel_binding)
# for any long-lived server — local dev, Render, Railway, a normal Node process.
# The pooler + channel_binding=require add 400-800ms to EVERY query from far regions.
#   DATABASE_URL="postgresql://USER:PASS@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
# Only Vercel/Lambda-style serverless should use the -pooler host (still drop
# channel_binding=require), because it opens a fresh connection per invocation.
DATABASE_URL="postgresql://postgres:password@localhost:5432/edusphere_db"
CORS_ORIGINS=http://localhost:3000,https://edupshere.vercel.app
JWT_SECRET=change_me_to_a_long_random_string
REFRESH_SECRET=change_me_to_a_different_long_random_string

# Dashboard AI assistant — any OpenAI-compatible chat completions endpoint works
# here (Groq, NVIDIA NIM, Together, Fireworks, etc.), so switching providers is
# just a matter of changing these three values, no code changes needed. Pick a
# model with tool/function-calling support (NIM: meta/llama-3.1-70b-instruct;
# Groq: llama-3.3-70b-versatile).
ASSISTANT_BASE_URL=https://integrate.api.nvidia.com/v1
ASSISTANT_API_KEY=nvapi-your-key-here
ASSISTANT_MODEL=openai/gpt-oss-20b
