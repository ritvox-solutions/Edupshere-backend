generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRoleEnum {
  super_admin
  school_admin
  teacher
  parent
  student
}

model School {
  id                  String   @id @default(uuid())
  name                String
  logo_url            String?
  address             String
  contact_email       String?
  contact_phone       String?
  principal_name      String?
  website             String?
  timezone            String   @default("Asia/Kolkata")
  currency            String   @default("INR")
  academic_year_start DateTime @db.Date
  academic_year_end   DateTime @db.Date
  language_default    String   @db.VarChar(2)
  subscription_status String
  board_id            String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  board          CurriculumBoard? @relation(fields: [board_id], references: [id])
  userRoles      UserRole[]
  classes        Class[]
  subjects       Subject[]
  students       Student[]
  fee_structures FeeStructure[]
  announcements  Announcement[]

  @@index([board_id])
}

model Profile {
  id                 String   @id @default(uuid())
  full_name          String
  username           String?  @unique
  phone              String?  @unique
  email              String?  @unique
  password_hash      String?
  preferred_language String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  userRoles         UserRole[]
  section_subjects  SectionSubject[]
  guardians         StudentGuardian[]
  announcements     Announcement[]
  timetable_entries TimetableEntry[]
}

model OtpCode {
  id          String    @id @default(uuid())
  phone       String
  code_hash   String
  expires_at  DateTime
  consumed_at DateTime?
  created_at  DateTime  @default(now())
}

model UserRole {
  id        String       @id @default(uuid())
  user_id   String
  school_id String
  role      UserRoleEnum

  user   Profile @relation(fields: [user_id], references: [id], onDelete: Cascade)
  school School  @relation(fields: [school_id], references: [id], onDelete: Cascade)

  @@unique([user_id, school_id, role])
  @@index([school_id])
  @@index([user_id])
}

model Class {
  id            String   @id @default(uuid())
  school_id     String
  name          String
  grade_level   Int?
  display_order Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  school         School         @relation(fields: [school_id], references: [id], onDelete: Cascade)
  sections       Section[]
  fee_structures FeeStructure[]

  @@index([school_id])
}

model Section {
  id               String   @id @default(uuid())
  class_id         String
  school_id        String
  name             String
  class_teacher_id String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  class             Class            @relation(fields: [class_id], references: [id], onDelete: Cascade)
  students          Student[]
  section_subjects  SectionSubject[]
  timetable_entries TimetableEntry[]

  @@index([school_id])
  @@index([class_id])
}

model Subject {
  id                      String   @id @default(uuid())
  school_id               String
  name                    String
  // Canonical board-syllabus subject name (e.g. "Mathematics"). The grade is
  // resolved per section from Class.grade_level at lookup time, so no direct
  // FK to the grade-specific CurriculumSubject row.
  curriculum_subject_name String?
  created_at              DateTime @default(now())

  school            School           @relation(fields: [school_id], references: [id], onDelete: Cascade)
  section_subjects  SectionSubject[]
  timetable_entries TimetableEntry[]

  @@index([school_id])
}

model SectionSubject {
  id         String @id @default(uuid())
  section_id String
  subject_id String
  teacher_id String

  section Section @relation(fields: [section_id], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  teacher Profile @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  @@unique([section_id, subject_id, teacher_id])
  @@index([section_id])
  @@index([teacher_id])
}

model Student {
  id             String    @id @default(uuid())
  school_id      String
  profile_id     String?
  full_name      String
  dob            DateTime? @db.Date
  section_id     String
  roll_number    String
  admission_date DateTime? @db.Date
  status         String    @default("active")
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  school    School            @relation(fields: [school_id], references: [id], onDelete: Cascade)
  section   Section           @relation(fields: [section_id], references: [id], onDelete: Cascade)
  guardians StudentGuardian[]

  @@index([school_id])
  @@index([section_id])
}

model StudentGuardian {
  id                  String  @id @default(uuid())
  student_id          String
  guardian_profile_id String
  relationship        String
  is_primary_contact  Boolean @default(false)

  student  Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
  guardian Profile @relation(fields: [guardian_profile_id], references: [id], onDelete: Cascade)

  @@unique([student_id, guardian_profile_id])
  @@index([student_id])
  @@index([guardian_profile_id])
}

model FeeStructure {
  id                  String    @id @default(uuid())
  school_id           String
  class_id            String
  fee_head            String
  amount              Decimal   @db.Decimal(10, 2)
  due_date            DateTime? @db.Date
  academic_year       String
  installment_options Int?      @default(1)
  created_at          DateTime  @default(now())

  school School @relation(fields: [school_id], references: [id], onDelete: Cascade)
  class  Class  @relation(fields: [class_id], references: [id], onDelete: Cascade)

  @@index([school_id])
  @@index([class_id])
}

model AttendanceRecord {
  id         String   @id @default(uuid())
  school_id  String
  section_id String
  student_id String
  date       DateTime @db.Date
  status     String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([student_id, date])
  @@index([school_id])
  @@index([section_id])
  @@index([student_id])
  @@index([school_id, date])
  @@index([section_id, date])
}

model NotificationLog {
  id         String   @id @default(uuid())
  school_id  String
  student_id String
  type       String
  status     String
  payload    String?
  created_at DateTime @default(now())

  @@index([school_id, created_at])
}

model TimetableEntry {
  id          String   @id @default(uuid())
  school_id   String
  section_id  String
  subject_id  String
  teacher_id  String
  day_of_week Int
  start_time  String
  end_time    String
  created_at  DateTime @default(now())

  section Section @relation(fields: [section_id], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  teacher Profile @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  @@index([school_id])
  @@index([section_id])
  @@index([teacher_id])
}

model Homework {
  id             String    @id @default(uuid())
  school_id      String
  section_id     String
  subject_id     String
  teacher_id     String
  title          String
  description    String
  due_date       DateTime? @db.Date
  attachment_url String?
  created_at     DateTime  @default(now())

  @@index([school_id, section_id])
}

model Exam {
  id            String   @id @default(uuid())
  school_id     String
  name          String
  academic_term String
  created_at    DateTime @default(now())

  @@index([school_id])
}

model Marks {
  id             String   @id @default(uuid())
  exam_id        String
  student_id     String
  subject_id     String
  marks_obtained Decimal  @db.Decimal(6, 2)
  max_marks      Decimal  @db.Decimal(6, 2)
  entered_by     String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@unique([exam_id, student_id, subject_id])
  @@index([exam_id, subject_id])
  @@index([student_id])
}

model Announcement {
  id             String   @id @default(uuid())
  school_id      String
  author_id      String
  audience_type  String
  audience_id    String?
  title          String
  body           String
  attachment_url String?
  priority       String   @default("medium")
  created_at     DateTime @default(now())

  school School  @relation(fields: [school_id], references: [id], onDelete: Cascade)
  author Profile @relation(fields: [author_id], references: [id], onDelete: Cascade)

  @@index([school_id])
}

// Per-teacher lesson plan against a syllabus unit (Phase 4). Tenant-scoped.
model LessonPlanEntry {
  id                 String    @id @default(uuid())
  school_id          String
  teacher_id         String
  section_id         String
  curriculum_unit_id String?
  title              String
  notes              String? // markdown
  status             String    @default("planned") // planned | in_progress | done
  planned_date       DateTime? @db.Date
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  @@unique([teacher_id, section_id, curriculum_unit_id])
  @@index([school_id])
  @@index([teacher_id, section_id])
}

// ── Curriculum library ─────────────────────────────────────────────────────
// Global reference data (no school_id) — board-aligned syllabi that schools
// resolve against via School.board_id + Class.grade_level + Subject.curriculum_subject_id.
// See 08_Lesson_Planner_Plan.md.

model CurriculumBoard {
  id         String   @id @default(uuid())
  name       String
  code       String   @unique
  region     String?
  created_at DateTime @default(now())

  subjects CurriculumSubject[]
  schools  School[]
}

model CurriculumSubject {
  id       String @id @default(uuid())
  board_id String
  grade    Int
  name     String

  board CurriculumBoard  @relation(fields: [board_id], references: [id], onDelete: Cascade)
  units CurriculumUnit[]

  @@unique([board_id, grade, name])
  @@index([board_id])
}

model CurriculumUnit {
  id                    String  @id @default(uuid())
  curriculum_subject_id String
  sequence              Int
  title                 String
  description           String?
  term                  Int?
  suggested_periods     Int?

  subject CurriculumSubject @relation(fields: [curriculum_subject_id], references: [id], onDelete: Cascade)
  topics  CurriculumTopic[]

  @@index([curriculum_subject_id])
}

model CurriculumTopic {
  id       String  @id @default(uuid())
  unit_id  String
  sequence Int
  title    String
  notes    String?

  unit CurriculumUnit @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  @@index([unit_id])
}
