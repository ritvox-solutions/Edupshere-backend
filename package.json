{
  "name": "edusphere-backend",
  "version": "0.1.0",
  "description": "Standalone API server for EduSphere",
  "main": "dist/index.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.37",
    "@prisma/client": "^6.16.0",
    "@sentry/node": "^10.70.0",
    "ai": "^7.0.79",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.0.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.10.0",
    "prisma": "^6.16.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.0"
  }
}
